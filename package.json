{
  "name": "hanara-sms-desktop",
  "version": "1.0.0",
  "description": "HANARA Schools Management System — Desktop Edition",
  "main": "electron/main.js",
  "author": "HANARA Schools <admin@hanaraschools.edu.gh>",
  "scripts": {
    "build:frontend": "bun run --cwd frontend build",
    "start:backend": "node backend/src/server.js",
    "build:exe": "bun run build:frontend && bun build --compile --windows-title=\"HANARA SMS\" --outfile=HANARA-SMS.exe ./desktop-launcher.js",
    "build:installer": "bun run build:frontend && electron-builder --win",
    "build": "bun run build:exe",
    "dist": "bun run build:installer",
    "start": "HANARA-SMS.exe"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.hanaraschools.sms",
    "productName": "HANARA SMS",
    "copyright": "Copyright © 2026 HANARA Schools",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "!backend/tests/**/*",
      "!backend/logs/**/*",
      "!backend/node_modules/.cache/**/*",
      "frontend/dist/**/*",
      "frontend/public/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HANARA SMS"
    }
  }
}
