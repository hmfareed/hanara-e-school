# Environment Variables — HANARA Schools SMS Backend
# Copy this file to .env and fill in your values before running.

# Server
NODE_ENV=development
PORT=5000

# MongoDB — Atlas URI or local
MONGODB_URI=mongodb://localhost:27017/hanara_sms

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — frontend origin (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Seed defaults (optional overrides)
SEED_ADMIN_EMAIL=admin@hanaraschools.edu.gh
SEED_ADMIN_PASSWORD=Admin@2026
SEED_ACCOUNTANT_EMAIL=acc@hanaraschools.edu.gh
SEED_ACCOUNTANT_PASSWORD=Accountant@2026

# WebPush VAPID (generate with web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@hanaraschools.edu.gh
